<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Lutris.Controls.GameEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Add game"
    PrimaryButtonText="Add"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="600" Spacing="16">
            <InfoBar x:Name="ValidationBar" Severity="Error" IsClosable="False" IsOpen="False" />

            <TextBox x:Name="TitleBox" Header="Title" PlaceholderText="e.g. Hollow Knight" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="ExeBox" Header="Executable" PlaceholderText="C:\Games\Hollow Knight\hollow_knight.exe" />
                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnBrowseExe" ToolTipService.ToolTip="Browse for the file that starts the game">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="Browse" />
                    </StackPanel>
                </Button>
            </Grid>

            <NumberBox
                x:Name="YearBox"
                Header="Release year"
                PlaceholderText="Optional"
                Minimum="1950"
                Maximum="2100"
                SmallChange="1"
                LargeChange="10"
                SpinButtonPlacementMode="Compact"
                Width="200"
                HorizontalAlignment="Left" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,4,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Portrait cover" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="3:4 · shown in the grid" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid
                        Width="168"
                        Height="224"
                        CornerRadius="8"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                            <FontIcon Glyph="&#xE91B;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="No image" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Rectangle x:Name="PortraitPreview" RadiusX="8" RadiusY="8" Visibility="Collapsed">
                            <Rectangle.Fill>
                                <ImageBrush x:Name="PortraitBrush" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PortraitChooseButton" Content="Choose image" Click="OnChoosePortrait" />
                        <Button x:Name="PortraitClearButton" Content="Remove" Click="OnClearPortrait" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="Landscape banner" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="16:9 · shown in the list and details" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid
                        Height="224"
                        CornerRadius="8"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                            <FontIcon Glyph="&#xE91B;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="No image" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Rectangle x:Name="LandscapePreview" RadiusX="8" RadiusY="8" Visibility="Collapsed">
                            <Rectangle.Fill>
                                <ImageBrush x:Name="LandscapeBrush" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="LandscapeChooseButton" Content="Choose image" Click="OnChooseLandscape" />
                        <Button x:Name="LandscapeClearButton" Content="Remove" Click="OnClearLandscape" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
